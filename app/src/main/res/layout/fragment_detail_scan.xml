<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFA">

    <View
        android:id="@+id/headerBg"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#245F58"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detail Analisis"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimpanChanges"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:text="Simpan Perubahan Nama"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#38C6A5"
        app:cornerRadius="16dp"
        app:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-40dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerBg"
        app:layout_constraintBottom_toTopOf="@id/btnSimpanChanges">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center_horizontal">

                    <RelativeLayout
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cvStatusIconBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="10dp"
                            app:cardCornerRadius="55dp"
                            app:cardBackgroundColor="#F1F5F9"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:id="@+id/ivDetailPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_menu_gallery" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cvDetailBadgeStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_centerHorizontal="true"
                            app:cardCornerRadius="12dp"
                            app:cardBackgroundColor="#38C6A5"
                            app:strokeWidth="2dp"
                            app:strokeColor="#FFFFFF"
                            app:cardElevation="2dp">
                            <TextView
                                android:id="@+id/tvDetailStatusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="Aman"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            app:cardCornerRadius="16dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:strokeWidth="1dp"
                            app:strokeColor="#E2E8F0"
                            app:cardElevation="4dp">
                            <TextView
                                android:id="@+id/tvDetailScore"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="0"
                                android:textColor="#1E293B"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                        </com.google.android.material.card.MaterialCardView>
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvDetailWaktu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Memuat tanggal..."
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginBottom="24dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nama Produk (Bisa Diedit)"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxStrokeColor="#38C6A5">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDetailNama"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:textColor="#1E293B"
                            android:textSize="15sp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFF4F4"
                app:strokeWidth="1dp"
                app:strokeColor="#FECDD3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kesimpulan Analisis"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#BE123C"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvKesimpulan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="#881337"
                        android:text="Memuat kesimpulan..."/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FECDD3" android:layout_marginVertical="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peringatan Khusus:"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#BE123C"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvPeringatan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="#881337"
                        android:text="- Memuat peringatan..."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#F1F5F9"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informasi Nilai Gizi"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#1E293B"
                        android:layout_marginBottom="16dp"/>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:useDefaultMargins="true">

                        <TextView android:text="Total Energi:" android:textColor="#64748B" android:textSize="13sp" android:layout_width="0dp" android:layout_columnWeight="1"/>
                        <TextView android:id="@+id/tvGiziEnergi" android:text="-" android:textStyle="bold" android:textColor="#1E293B" android:textSize="13sp" android:layout_width="wrap_content"/>

                        <TextView android:text="Gula:" android:textColor="#64748B" android:textSize="13sp" android:layout_width="0dp" android:layout_columnWeight="1"/>
                        <TextView android:id="@+id/tvGiziGula" android:text="-" android:textStyle="bold" android:textColor="#1E293B" android:textSize="13sp" android:layout_width="wrap_content"/>

                        <TextView android:text="Lemak:" android:textColor="#64748B" android:textSize="13sp" android:layout_width="0dp" android:layout_columnWeight="1"/>
                        <TextView android:id="@+id/tvGiziLemak" android:text="-" android:textStyle="bold" android:textColor="#1E293B" android:textSize="13sp" android:layout_width="wrap_content"/>

                        <TextView android:text="Karbohidrat:" android:textColor="#64748B" android:textSize="13sp" android:layout_width="0dp" android:layout_columnWeight="1"/>
                        <TextView android:id="@+id/tvGiziKarbo" android:text="-" android:textStyle="bold" android:textColor="#1E293B" android:textSize="13sp" android:layout_width="wrap_content"/>

                        <TextView android:text="Protein:" android:textColor="#64748B" android:textSize="13sp" android:layout_width="0dp" android:layout_columnWeight="1"/>
                        <TextView android:id="@+id/tvGiziProtein" android:text="-" android:textStyle="bold" android:textColor="#1E293B" android:textSize="13sp" android:layout_width="wrap_content"/>

                        <TextView android:text="Garam/Sodium:" android:textColor="#64748B" android:textSize="13sp" android:layout_width="0dp" android:layout_columnWeight="1"/>
                        <TextView android:id="@+id/tvGiziGaram" android:text="-" android:textStyle="bold" android:textColor="#1E293B" android:textSize="13sp" android:layout_width="wrap_content"/>

                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#F8FAFC"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Komposisi Bahan"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#334155"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvKomposisi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="#475569"
                        android:text="Memuat bahan..."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>